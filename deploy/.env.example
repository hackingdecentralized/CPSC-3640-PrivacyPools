# deploy/.env: settings and secrets for the VPS stack (docker-compose.yml). Set up with:
#
#   cp .env.example .env && chmod 600 .env
#
# up.sh refuses to start unless deploy/.env exists and has mode 600. The file is git-ignored: never commit it,
# paste it into chat, or copy it off the server. Each container receives only the variables it needs.
# Format: one KEY=value per line, no spaces around "=", no quotes needed.

# ---------------------------------------------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------------------------------------------

# Deployment record to mount, from the repo: deployments/<DEPLOYMENT>.json. Leave it as sepolia.
DEPLOYMENT=sepolia

# Sepolia JSON-RPC URL, used by both the ASP and the relayer. Prefer a keyed provider (Alchemy, Infura), since the
# ASP polls every few seconds. A keyless fallback is https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=

# ---------------------------------------------------------------------------------------------------------------
# Public hostnames. Caddy gets an HTTPS certificate for each one automatically.
# ---------------------------------------------------------------------------------------------------------------
# Both names must resolve to this server's public IP, and ports 80 and 443 must be open to the internet.
# With your own domain, add two A records, for example:
#   ASP_HOST=asp.example.edu
#   RELAYER_HOST=relayer.example.edu
# Without a domain, use sslip.io: any name that contains an IP address resolves to that IP. For a server at
# 203.0.113.7:
#   ASP_HOST=asp.203.0.113.7.sslip.io
#   RELAYER_HOST=relayer.203.0.113.7.sslip.io
# The website (Vercel) is configured with https://<ASP_HOST> and https://<RELAYER_HOST>.
ASP_HOST=
RELAYER_HOST=

# ---------------------------------------------------------------------------------------------------------------
# Teaching ASP (asp service)
# ---------------------------------------------------------------------------------------------------------------

# Private key (0x + 64 hex) of the postman wallet: the address in roles.postman of deployments/sepolia.json, which
# holds ASP_POSTMAN on the Entrypoint and pays the gas for every root it publishes. Fund it with about
# 0.05 Sepolia ETH and keep it topped up.
# WARNING: use a fresh wallet made only for this (`cast wallet new`). Never a well-known or test key, such as the
# anvil/hardhat dev accounts: on Sepolia those are delegated to sweeper contracts that steal any ETH sent to them.
# Do not reuse the relayer's key either, or the two services will fight over the same nonces.
POSTMAN_PRIVATE_KEY=

# Teacher wallet address(es), comma-separated. Only the addresses go here: the teacher signs a login message with
# that wallet (in the browser) to get a short-lived admin token.
ADMIN_ADDRESSES=

# HMAC secret for admin tokens, at least 32 characters. Generate one with: openssl rand -hex 32
# Changing it logs every admin out.
ADMIN_TOKEN_SECRET=

# Origins allowed to call the ASP from a browser, comma-separated, no trailing slash. Set this to the website's
# URL, for example https://course-privacy-pool.vercel.app (add a custom domain too if the site has one).
# Empty means "*" (any origin): fine for a first test, but set it before class.
CORS_ORIGINS=

# Optional tuning. Leave empty for the ASP's defaults (shown in brackets).
# Initial auto-approve delay in seconds [120]. Once the teacher changes it in the admin panel, the stored value
# wins over this one.
AUTO_APPROVE_DELAY_SEC=
# Initial minimum seconds between two root publishes [60]. Also changeable in the admin panel.
PUBLISH_INTERVAL_SEC=
# Indexer/publisher loop period in milliseconds [6000].
POLL_INTERVAL_MS=
# Blocks to wait before indexing a deposit [2].
CONFIRMATIONS=
# Maximum block range per eth_getLogs call [500]. Lower it if your RPC provider rejects wide log ranges.
LOG_CHUNK_SIZE=

# The ASP keeps its database in the Docker volume privacy-pool_asp-data. The teacher's declines and settings
# live ONLY there, so keep that volume: never run `docker compose down -v` or `docker volume rm` on it, and back
# it up as described in deploy/README.md.

# ---------------------------------------------------------------------------------------------------------------
# Relayer (relayer service)
# ---------------------------------------------------------------------------------------------------------------

# Private key (0x + 64 hex) of the relayer wallet. It sends every relayed withdrawal (paying the gas) and receives
# the relay fees. Fund it with about 0.1 Sepolia ETH (one withdrawal costs about 500k gas) and keep it topped up.
# WARNING: use a fresh wallet made only for this (`cast wallet new`), different from the postman. Never a
# well-known or test key: the pools pay the fee to this address on every ETH withdrawal, and a test account's
# sweeper delegation on Sepolia would drain the relayer.
RELAYER_PRIVATE_KEY=

# Flat relay fee for both ETH and BULLDOGS, in basis points (10 = 0.1% of the withdrawn amount). It must be at
# least 1, because the unmodified website refuses a 0 fee. It can be at most 100, the pools' on-chain
# maxRelayFeeBPS; the relayer refuses to start above that.
RELAYER_FEE_BPS=10
